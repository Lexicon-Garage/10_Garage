@model Garage.Web.ViewModels.Admin.ActiveParkingFilterViewModel

@{
    ViewData["Title"] = "Aktiva parkeringar";
}

<div class="container mt-4">
    <div class="mb-4">

        <h1>Aktiva parkeringar</h1>

        <p class="text-muted">
            Översikt över alla fordon som för närvarande är parkerade.
        </p>

    </div>


    <!-- ========================================================= -->
    <!-- SEARCH AND FILTER -->
    <!-- ========================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="ParkingSessions"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">


                    <!-- Registration number search -->

                    <div class="col-md-5">

                        <label for="searchTerm"
                               class="form-label">

                            Registreringsnummer

                        </label>

                        <input type="text"
                               id="searchTerm"
                               name="searchTerm"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Sök registreringsnummer..." />

                    </div>


                    <!-- Vehicle type -->

                    <div class="col-md-4">

                        <label for="vehicleTypeId"
                               class="form-label">

                            Fordonstyp

                        </label>

                        <select id="vehicleTypeId"
                                name="vehicleTypeId"
                                class="form-select">

                            <option value="">
                                Alla fordonstyper
                            </option>

                            @foreach (var type in Model.VehicleTypes)
                            {
                                if (type.Value == Model.VehicleTypeId?.ToString())
                                {
                                    <option value="@type.Value"
                                            selected>
                                        @type.Text
                                    </option>
                                }
                                else
                                {
                                    <option value="@type.Value">
                                        @type.Text
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- Buttons -->

                    <div class="col-md-3">

                        <button type="submit"
                                class="btn btn-primary">

                            Sök

                        </button>

                        <a asp-area="Admin"
                           asp-controller="ParkingSessions"
                           asp-action="Index"
                           class="btn btn-secondary">

                            Rensa

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- RESULTS -->
    <!-- ========================================================= -->
    @if (!Model.Results.Any())
    {
        <div class="alert alert-info">

            Det finns inga aktiva parkeringar som matchar sökningen.

        </div>
    }
    else
    {
        <div class="mb-3">

            <strong>
                @Model.Results.Count() aktiva parkeringar
            </strong>

        </div>


        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>
                            Ägare
                        </th>

                        <th>
                            Fordonstyp
                        </th>

                        <th>
                            Registreringsnummer
                        </th>

                        <th>
                            Platsnummer
                        </th>

                        <th>
                            Location
                        </th>

                        <th>
                            Incheckningstid
                        </th>

                        <th>
                            Parkeringstid
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var parking in Model.Results)
                    {
                        <tr>

                            <td>
                                @parking.OwnerName
                            </td>

                            <td>
                                @parking.VehicleTypeName
                            </td>

                            <td>
                                <strong>
                                    @parking.RegistrationNumber
                                </strong>
                            </td>

                            <td>
                                @parking.SpotNumber
                            </td>

                            <td>
                                @parking.Location
                            </td>

                            <td>
                                @parking.CheckInTime.ToString("yyyy-MM-dd HH:mm")
                            </td>

                            <td>

                                @if (parking.ParkingTime.Days > 0)
                                {
                                    @parking.ParkingTime.Days
                                    <span>d</span>
                                }

                                @parking.ParkingTime.Hours
                                <span>h</span>

                                @parking.ParkingTime.Minutes
                                <span>min</span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>