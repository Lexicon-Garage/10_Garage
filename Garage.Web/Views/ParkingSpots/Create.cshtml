@model Garage.Web.ViewModels.Admin.ParkingSpotCreateViewModel

@{
    ViewData["Title"] = "Skapa parkeringsplats";
}

<div class="container mt-4">

    <h1>Skapa parkeringsplats</h1>

    <hr />

    <div class="row">

        <div class="col-md-6">

            <form asp-area="Admin"
                  asp-controller="ParkingSpots"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- Spot Number -->

                <div class="mb-3">

                    <label asp-for="SpotNumber"
                           class="form-label">
                        Platsnummer
                    </label>

                    <input asp-for="SpotNumber"
                           class="form-control"
                           placeholder="Exempel: A01" />

                    <span asp-validation-for="SpotNumber"
                          class="text-danger">
                    </span>

                </div>

                <!-- Location -->

                <div class="mb-3">

                    <label asp-for="Location"
                           class="form-label">
                        Location
                    </label>

                    <input asp-for="Location"
                           class="form-control"
                           placeholder="Exempel: Garage 1" />

                    <span asp-validation-for="Location"
                          class="text-danger">
                    </span>

                </div>

                <!-- Vehicle Type -->

                <div class="mb-3">

                    <label asp-for="VehicleTypeId"
                           class="form-label">
                        Fordonstyp
                    </label>

                    <select asp-for="VehicleTypeId"
                            asp-items="ViewBag.VehicleTypes"
                            class="form-select">

                        <option value="">
                            -- Välj fordonstyp --
                        </option>

                    </select>

                    <span asp-validation-for="VehicleTypeId"
                          class="text-danger">
                    </span>

                </div>

                <!-- Out of Service -->

                <div class="form-check mb-3">

                    <input asp-for="IsOutOfService"
                           class="form-check-input" />

                    <label asp-for="IsOutOfService"
                           class="form-check-label">
                        Ur funktion
                    </label>

                </div>

                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Spara
                    </button>

                    <a asp-area="Admin"
                       asp-controller="ParkingSpots"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Avbryt
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}