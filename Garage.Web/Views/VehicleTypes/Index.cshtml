@model IEnumerable<Garage.Web.Models.VehicleType>

@{
    ViewData["Title"] = "Fordonstyper";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Fordonstyper</h1>

        <a asp-area="Admin"
           asp-controller="VehicleTypes"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus"></i>
            Skapa fordonstyp
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Det finns inga fordonstyper ännu.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Namn</th>
                    <th>Antal fordon</th>
                    <th>Antal parkeringsplatser</th>
                    <th class="text-end">Åtgärder</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Name</strong>
                        </td>

                        <td>
                            @item.Vehicles.Count
                        </td>

                        <td>
                            @item.ParkingSpots.Count
                        </td>

                        <td class="text-end">

                            <a asp-area="Admin"
                               asp-controller="VehicleTypes"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-info">
                                Visa
                            </a>

                            <a asp-area="Admin"
                               asp-controller="VehicleTypes"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning">
                                Redigera
                            </a>

                            <a asp-area="Admin"
                               asp-controller="VehicleTypes"
                               asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-danger">
                                Ta bort
                            </a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>