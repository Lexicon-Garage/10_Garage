@model Garage.Web.ViewModels.Admin.VehicleTypeCreateViewModel

@{
    ViewData["Title"] = "Skapa fordonstyp";
}

<div class="container mt-4">

    <h1>Skapa fordonstyp</h1>

    <hr />

    <div class="row">
        <div class="col-md-6">

            <form asp-area="Admin"
                  asp-controller="VehicleTypes"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                        Namn
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Exempel: Bil" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Spara
                    </button>

                    <a asp-area="Admin"
                       asp-controller="VehicleTypes"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Avbryt
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}