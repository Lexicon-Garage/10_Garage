@using Microsoft.AspNetCore.Identity
@using Garage.Web.Models
@using Garage.Web.Constants

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Garage.Web</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Garage.Web.styles.css"
          asp-append-version="true" />

</head>


<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">

            <div class="container">


                <!-- BRAND -->

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Vehicles"
                   asp-action="Index">

                    Garage.Web

                </a>


                <!-- MOBILE TOGGLE -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Vehicles" asp-action="Index">Garage.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- NAVIGATION -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">


                    <!-- LEFT MENU -->

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">


                        <!-- HOME -->

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                   <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Vehicles"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <!-- ADD VEHICLE -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Vehicles"
                               asp-action="Create">

                                Add Vehicle

                            </a>

                        </li>


                        <!-- ADMIN -->
                        @if (Context.User.IsInRole("Admin"))
                        {
                            
                            <ul>
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   id="adminDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    Administration

                                </a>


                                <ul class="dropdown-menu"
                                    aria-labelledby="adminDropdown">

                                    <!-- Active Parkings -->

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="ParkingSessions"
                                           asp-action="Index">

                                            Active Parkings

                                        </a>
                                    </li>

                                    <!-- PARKING SPOTS -->

                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="ParkingSpots"
                                           asp-action="Index">

                                            Parking Spots

                                        </a>

                                    </li>


                                    <!-- ADD PARKING SPOT -->

                                    <li>

                                        <a class="dropdown-item"
                                           
                                           asp-controller="ParkingSpots"
                                           asp-action="Create">

                                            Add Parking Spot

                                        </a>

                                    </li>


                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>


                                    <!-- VEHICLE TYPES -->

                                    <li>

                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="VehicleTypes"
                                           asp-action="Index">

                                            Vehicle Types

                                        </a>

                                    </li>


                                    <!-- ADD VEHICLE TYPE -->

                                    <li>

                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="VehicleTypes"
                                           asp-action="Create">

                                            Add Vehicle Type

                                        </a>

                                    </li>

                                </ul>
                            
                        }

                    </ul>


                    <!-- RIGHT MENU -->

                    <ul class="navbar-nav">

                     @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ParkedVehicles" asp-action="Index">Parked Vehicles</a>
                            </li>

                            @if (User.IsInRole(RoleNames.Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Users" asp-action="Index">Users</a>
                                </li>
                            }

                            <li class="nav-item">
                                <span class="nav-link text-dark">Hello, @User.Identity!.Name!</span>
                            </li>
                        }
                        <partial name="_LoginPartial" />

                    </ul>


                </div>

            </div>

        </nav>

    </header>


    <!-- PAGE CONTENT -->

    <div class="container">

        <main role="main"
              class="pb-3">

            <partial name="_Success" />

            @RenderBody()

        </main>

    </div>


    <!-- FOOTER -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - Garage.Web -

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>
                </body>

    <!-- JAVASCRIPT -->

                    <script src="~/lib/jquery/dist/jquery.min.js"></script>
                    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                    <script src="~/js/site.js" asp-append-version="true"></script>

                    @await RenderSectionAsync("Scripts", required: false)


</html>
