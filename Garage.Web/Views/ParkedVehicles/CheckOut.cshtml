@model Garage.Web.ViewModels.CheckOutViewModel

@{
    ViewData["Title"] = "Check out vehicle";
}

<h1>Check out vehicle</h1>

<div class="card" style="max-width:600px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Registration number</dt>
            <dd class="col-sm-8">@Model.RegistrationNumber</dd>

            <dt class="col-sm-4">Vehicle type</dt>
            <dd class="col-sm-8">@Model.VehicleTypeName</dd>

            <dt class="col-sm-4">Brand / model</dt>
            <dd class="col-sm-8">@Model.BrandName @Model.Model</dd>

            <dt class="col-sm-4">Colour</dt>
            <dd class="col-sm-8">@Model.Color</dd>

            <dt class="col-sm-4">Checked in</dt>
            <dd class="col-sm-8">@Model.CheckInTime.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-4">Parking spot</dt>
            <dd class="col-sm-8">@string.Join(", ", Model.SpotNumbers)</dd>
        </dl>
    </div>
</div>

<form asp-action="CheckOut" method="post" class="mt-3">
    <input type="hidden" name="id" value="@Model.SessionId" />

    <button type="submit" class="btn btn-success">Confirm check out</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>