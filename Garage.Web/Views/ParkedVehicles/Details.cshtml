@model Garage.Web.ViewModels.ParkedVehicleDetailsViewModel
@{
    ViewData["Title"] = "Details";
}


<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 p-4 bg-light rounded border shadow-sm ">

            <div class="text-center mb-4">
                <h1 class="display-6">Details page</h1>
                <p class="text-muted">For parked vehicle - number @Html.DisplayFor(model => model.RegistrationNumber)
                </p>
                <hr/>
            </div>
    <dl>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.VehicleType)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.VehicleType)
        </dd>
    </dl>
    <dl>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.RegistrationNumber)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.RegistrationNumber)
        </dd>
    </dl>
    <dl>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Color)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Color)
        </dd>
    </dl>
    <dl>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.BrandType)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.BrandType)
        </dd>
    </dl>
    <dl>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Model)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Model)
        </dd>
    </dl>
    <dl>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.NumberOfWheels)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.NumberOfWheels)
        </dd>
    </dl>

    <dl>
        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.ArrivedTime)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.ArrivedTime)
        </dd>
    </dl>

    <div class="d-flex gap-2 mt-4">
    <a asp-action="Index" class="btn btn-secondary w-100 py-2 text-center">Back to List</a>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-success w-100 py-2">Edit details</a> 
    </div>
</div>
</div>
</div>

