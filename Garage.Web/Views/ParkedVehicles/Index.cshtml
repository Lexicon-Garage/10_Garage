@model IEnumerable<Garage.Web.ViewModels.ParkedVehicleOverviewViewModel>

@{
    ViewData["Title"] = "Garage overview";
}

<h1>Parked vehicles</h1>
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width: 400px;">
        <input type="text" name="searchString" value="@ViewData["SearchString"]"
               class="form-control" placeholder="Search by registration number" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>
<p>
    <a asp-action="Create" class="btn btn-primary">Park a vehicle</a>
</p>

@if (!Model.Any())
{
     @if (!string.IsNullOrWhiteSpace(ViewData["SearchString"] as string))
    {
        <p>No vehicles found matching "@ViewData["SearchString"]".</p>
        <a asp-action="Index">Show all vehicles</a>
    }
    else
    {
        <p>The garage is empty.</p>
    }
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Type</th>
                <th>Registration number</th>
                <th>Arrival time</th>
                <th>Parked for</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.VehicleType</td>
                <td>@item.RegistrationNumber</td>
                <td>@item.ArrivedTime.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.ParkedDurationDisplay</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Check out</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}