@model IEnumerable<Garage.Web.ViewModels.ParkingOverviewViewModel>
@{
    var curCol = ViewData["SortColumn"] as string;
    var curDir = ViewData["SortDir"] as string;

    string NextDir(string col) => curCol == col && curDir == "asc" ? "desc" : "asc";
    string Arrow(string col) => curCol != col ? "" : curDir == "asc" ? " ▲" : " ▼";
}
@{
    ViewData["Title"] = "Garage overview";
}

<div class="text-center mb-4">
    <h1 class="display-6">Parked vehicles</h1>
</div>
<div class="d-flex justify-content-between mt-4">
    <p>
        <a asp-action="Create" class="btn btn-success w-20 py-2">Park a vehicle</a>
    </p>
    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group" style="max-width: 400px;">
            <input type="text" name="searchString" value="@ViewData["SearchString"]" class="form-control"
                   placeholder="Search by registration number" />
            <button type="submit" class="btn btn-outline-primary">Search</button>
        </div>
        <input type="hidden" name="sortColumn" value="@curCol" />
        <input type="hidden" name="sortDir" value="@curDir" />
    </form>

</div>

@if (!Model.Any())
{
    @if (!string.IsNullOrWhiteSpace(ViewData["SearchString"] as string))
    {
        <p>No vehicles found matching "@ViewData["SearchString"]".</p>
        <a asp-action="Index">Show all vehicles</a>
    }
    else
    {
        <p>The garage is empty.</p>
    }
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index" asp-route-searchString="@ViewData["SearchString"]" asp-route-sortColumn="type"
                       asp-route-sortDir="@NextDir("type")">Type@(Arrow("type"))</a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-searchString="@ViewData["SearchString"]" asp-route-sortColumn="reg"
                       asp-route-sortDir="@NextDir("reg")">Registration number@(Arrow("reg"))</a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-searchString="@ViewData["SearchString"]" asp-route-sortColumn="arrived"
                       asp-route-sortDir="@NextDir("arrived")">Arrival time@(Arrow("arrived"))</a>
                </th>
                <th>Parked for</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.VehicleTypeName</td>
                    <td>@item.RegistrationNumber</td>
                    <td>@item.CheckInTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.ParkedDurationDisplay</td>
                    <td>@string.Join(", ", item.SpotNumbers)</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.SessionId" class="text-decoration-none">Details</a> |
                        <a asp-action="Edit" asp-route-id="@item.VehicleId" class="text-decoration-none">Edit</a> |
                        <a asp-action="CheckOut" asp-route-id="@item.SessionId" class="text-decoration-none">Check out</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
