@model IEnumerable<Garage.Web.ViewModels.ParkedVehicleOverviewViewModel>

@{
    ViewData["Title"] = "Garage overview";
}

<h1>Parked vehicles</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Park a vehicle</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.RegistrationNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VehicleType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ArrivedTime)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.RegistrationNumber)
            </td>
            <td>
                @Html.DisplayFor(model => item.VehicleType)
            </td>
            <td>
                @Html.DisplayFor(model => item.ArrivedTime)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="CheckOut" asp-route-id="@item.Id">CheckOut</a>
            </td>
        </tr>
}
    </tbody>
</table>
