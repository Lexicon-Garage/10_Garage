@model IEnumerable<Garage.Web.ViewModels.ParkingOverviewViewModel>

@{
    ViewData["Title"] = "Parked vehicles";
}

<h1>Parked vehicles</h1>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width:400px;">
        <input type="text" name="searchString" value="@ViewData["SearchString"]"
               class="form-control" placeholder="Search reg number, type, colour or model" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Park a vehicle</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        @(string.IsNullOrWhiteSpace(ViewData["SearchString"] as string)
            ? "No vehicles are currently parked."
            : $"No parked vehicles match \"{ViewData["SearchString"]}\".")
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Type</th>
                <th>Registration number</th>
                <th>Checked in</th>
                <th>Parked for</th>
                <th>Spot</th>
                <th>Cost so far</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.VehicleTypeName</td>
                <td>@item.RegistrationNumber</td>
                <td>@item.CheckInTime.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.ParkedDurationDisplay</td>
                <td>@string.Join(", ", item.SpotNumbers)</td>
               <td>@item.RunningCost.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("sv-SE"))</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.SessionId">Details</a> |
                    <a asp-action="CheckOut" asp-route-id="@item.SessionId">Check out</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}