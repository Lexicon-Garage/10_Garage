@model Garage.Web.ViewModels.VehicleEditViewModel

@{
    ViewData["Title"] = "Edit";
}
<div class="container mt-4">
    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6 p-4 bg-light rounded border shadow-sm ">

            <div class="text-center mb-4">
                <h1 class="display-6">Edit details</h1>
                <p class="text-muted">for parked vehicle - number @Html.DisplayFor(model => model.RegistrationNumber) </p>
                <hr />
            </div>

            <div class="row">
                <div class="col-md-12">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="VehicleTypeId"></label>
                            <select asp-for="VehicleTypeId" asp-items="Model.VehicleTypes" class="form-control"></select>
                            <span asp-validation-for="VehicleTypeId" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="RegistrationNumber"></label>
                            <input asp-for="RegistrationNumber" class="form-control" />
                            <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Color"></label>
                            <input asp-for="Color" class="form-control" />
                            <span asp-validation-for="Color" class="text-danger"></span>
                        </div>
                        @* <div class="form-group">
                            <label asp-for="BrandType"></label>
                            <select asp-for="BrandType" asp-items="Model.BrandTypes" class="form-control"></select>
                            <span asp-validation-for="BrandType" class="text-danger"></span>
                        </div> *@
                        <div class="form-group">
                            <label asp-for="Model"></label>
                            <input asp-for="Model" class="form-control" />
                            <span asp-validation-for="Model" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="NumberOfWheels"></label>
                            <input asp-for="NumberOfWheels" class="form-control" />
                            <span asp-validation-for="NumberOfWheels" class="text-danger"></span>
                        </div>

                        
                       

                        <div class="form-group">
                            <label>Arrived Time</label>
@*                             <p class="form-control-plaintext">@Model.ArrivedTime</p>
 *@                        </div>
                        
                        <div class="d-flex gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-secondary w-100 py-2 text-center">Back to List</a>
                            <button type="submit" class="btn btn-success w-100 py-2">Save details</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
