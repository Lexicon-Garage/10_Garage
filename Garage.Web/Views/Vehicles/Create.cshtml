@model CreateVehicleViewModel

@{
    ViewData["Title"] = "Add Vehicle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="text-center mb-4">
                <h1 class="display-6">Vehicle Check-In</h1>
                <p class="text-muted">Add your Vehicle.</p>
            </div>

            <form asp-action="Create" method="post" class="p-4 bg-light rounded border shadow-sm">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                @foreach (var property in ViewData.ModelMetadata.Properties)
                {
                    if (property.PropertyName == nameof(Model.VehicleTypes) ||
                       property.PropertyName == nameof(Model.BrandTypes))
                        {
                            continue;
                        }

                        var labelText = property.DisplayName ?? property.PropertyName ?? string.Empty;

                        var postedValue = property.PropertyGetter?.Invoke(Model)?.ToString() ?? "";

                        var hasServerError = ViewData.ModelState.TryGetValue(property.PropertyName ?? "", out var modelStateEntry);
                        var serverErrorMessage = hasServerError
                            ? modelStateEntry?.Errors.FirstOrDefault()?.ErrorMessage
                            : "";

                        var isRequired = property.IsRequired;

                        var rangeAttribute = property.ValidatorMetadata
                            .OfType<System.ComponentModel.DataAnnotations.RangeAttribute>()
                            .FirstOrDefault();

                        var lengthAttribute = property.ValidatorMetadata
                            .OfType<System.ComponentModel.DataAnnotations.StringLengthAttribute>()
                            .FirstOrDefault();

                        <div class="mb-3">

                            <label for="@property.PropertyName" class="form-label fw-bold">
                                @labelText
                            </label>


                            @* VehicleType dropdown *@
                            @if (property.PropertyName == nameof(Model.VehicleTypeId))
                            {
                                <select asp-for="VehicleTypeId"
                                        asp-items="Model.VehicleTypes"
                                        class="form-select">
                                    <option value="">-- Select Vehicle Type --</option>
                                </select>
                            }
                        else if (property.PropertyName == nameof(Model.BrandTypeId))
                        {
                            <select asp-for="BrandTypeId"
                                    asp-items="Model.BrandTypes"
                                    class="form-select">
                                <option value="">-- Select Brand Type --</option>
                            </select>
                        }

                            @* Integer fields except VehicleTypeId *@
                            else if (property.ModelType == typeof(int))
                            {
                                <input type="number"
                                       name="@property.PropertyName"
                                       id="@property.PropertyName"
                                       class="form-control"
                                       value="@postedValue"
                                       data-val="true"
                                       data-val-required="The @labelText field is required."
                                       data-val-range="@(rangeAttribute != null ? $"The field {labelText} must be between {rangeAttribute.Minimum} and {rangeAttribute.Maximum}." : "")"
                                       data-val-range-min="@(rangeAttribute?.Minimum)"
                                       data-val-range-max="@(rangeAttribute?.Maximum)" />
                            }


                            @* Normal text fields *@
                            else
                            {
                                var regexAttribute = property.ValidatorMetadata
                                    .OfType<System.ComponentModel.DataAnnotations.RegularExpressionAttribute>()
                                    .FirstOrDefault();

                                <input type="text"
                                       name="@property.PropertyName"
                                       id="@property.PropertyName"
                                       class="form-control"
                                       value="@postedValue"
                                       data-val="true"
                                       data-val-required="The @labelText field is required."
                                       data-val-length="@(lengthAttribute != null ? $"The {labelText} must be between {lengthAttribute.MinimumLength} and {lengthAttribute.MaximumLength} characters." : "")"
                                       data-val-length-min="@(lengthAttribute?.MinimumLength)"
                                       data-val-length-max="@(lengthAttribute?.MaximumLength)"
                                @(regexAttribute != null ? Html.Raw($"data-val-regex=\"{regexAttribute.ErrorMessage}\"") : null)
                                @(regexAttribute != null ? Html.Raw($"data-val-regex-pattern=\"{regexAttribute.Pattern}\"") : null) />
                            }

                            <span class="text-danger field-validation-error"
                                  data-valmsg-for="@property.PropertyName"
                                  data-valmsg-replace="true">
                                @serverErrorMessage
                            </span>

                        </div>

                }

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success w-100 py-2">Add Vehicle</button>
                    <a asp-action="Index" class="btn btn-secondary w-100 py-2 text-center">Cancel</a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
